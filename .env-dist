# Скопировать в .env (права 600). Описание — README.md, «Установка на сервере».

# Образ из закрытого registry: тег = коммит репозитория, из которого собран
CRYPTOPRO_IMAGE=<registry>/spellsmell/cryptopro:<коммит>

# Токен API: openssl rand -hex 32. Тот же — в common-local.php CRM: params['cryptopro']['token']
CRYPTOPRO_API_TOKEN=

# Сеть стека CRM на этом хосте (/docker/ss-admin/backend/primary/docker-compose)
CRM_NETWORK=docker-compose_spellsmell
